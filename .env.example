# ZXZ Trading Bot Configuration

# Binance API Credentials (主帳戶)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# Bybit API Credentials
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_SECRET_KEY=your_bybit_secret_key_here

# Server
PORT=3000
NODE_ENV=production

# IP Whitelist (comma separated)
IP_WHITELIST=127.0.0.1,::1

# Encryption Key for API Keys storage
ENCRYPTION_KEY=your-256-bit-encryption-key-change-this

# JWT Secret for API authentication
JWT_SECRET=your-jwt-secret-change-this

# Admin Password for bot management
ADMIN_PASSWORD=zxz_admin_2024

# FIO / Trust Wallet Payment (熱錢包 - 用於提款)
# 警告: 請使用專用的熱錢包，不要使用主錢包私鑰
FIO_HOT_WALLET_KEY=your_fio_private_key_here
FIO_HOT_WALLET_ADDRESS=your_fio_public_address_here

# FIO 收款地址 (用於存款監控)
FIO_PUBLIC_ADDRESS=FIO6VvxJTM2cLz1qHnjMHyDbTE3kN5AkpYEtRaVmrPGv8mrYfGCw3
